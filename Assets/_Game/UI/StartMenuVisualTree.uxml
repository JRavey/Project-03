<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(0, 126, 176);">
        <ui:Label text="Project 03" name="GameTitle" style="align-self: center; padding-top: 300px; font-size: 120px; -unity-font-style: bold; color: rgb(255, 50, 0); -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; text-shadow: 7px 6px 13px rgb(0, 0, 0);"/>
        <ui:Label text="High Score: 000 " name="HighScoreText" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 67px; -unity-font-style: bold; align-self: auto; padding-top: 176px;"/>
        <ui:Button text="Start" name="StartButton" style="background-color: rgb(219, 158, 115); color: rgb(0, 0, 0); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-left-color: rgb(128, 65, 21); border-right-color: rgb(128, 65, 21); border-top-color: rgb(128, 65, 21); border-bottom-color: rgb(128, 65, 21); margin-top: 100px; margin-right: 150px; margin-bottom: 100px; margin-left: 150px; -unity-font-style: bold; font-size: 80px;"/>
        <ui:Button text="Quit" name="QuitButton" style="background-color: rgb(219, 158, 115); color: rgb(0, 0, 0); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-left-color: rgb(128, 65, 21); border-right-color: rgb(128, 65, 21); border-top-color: rgb(128, 65, 21); border-bottom-color: rgb(128, 65, 21); margin-top: 100px; margin-right: 150px; margin-bottom: 100px; margin-left: 150px; -unity-font-style: bold; font-size: 80px;"/>
        <ui:Button text="Reset Save" name="ResetDataButton" style="background-color: rgb(219, 158, 115); color: rgb(0, 0, 0); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-left-color: rgb(128, 65, 21); border-right-color: rgb(128, 65, 21); border-top-color: rgb(128, 65, 21); border-bottom-color: rgb(128, 65, 21); margin-top: 380px; margin-right: 25px; margin-bottom: 0; margin-left: 589px; -unity-font-style: normal; font-size: 80px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
    </ui:VisualElement>
</ui:UXML>
