<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.871);">
        <ui:Label text="Game Ended" name="GameEndTitle" style="align-self: center; padding-top: 300px; font-size: 120px; -unity-font-style: bold; color: rgb(255, 213, 136); -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; text-shadow: 7px 6px 13px rgb(0, 0, 0);"/>
        <ui:Button text="Retry" name="RetryButton" style="background-color: rgb(159, 159, 159); color: rgb(0, 0, 0); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: 100px; margin-right: 150px; margin-bottom: 100px; margin-left: 150px; -unity-font-style: bold; font-size: 80px;"/>
        <ui:Button text="Main Menu" name="MainMenuButton" style="background-color: rgb(159, 159, 159); color: rgb(0, 0, 0); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: 100px; margin-right: 150px; margin-bottom: 100px; margin-left: 150px; -unity-font-style: bold; font-size: 80px;"/>
    </ui:VisualElement>
</ui:UXML>
